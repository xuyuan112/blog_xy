<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuyuan.blog.admin.mapper.UserMapper">

    <!--
        根据用户名查询单条用户记录
        - 显式写出别名映射, 与 User.java 字段保持一致 (虽然 map-underscore-to-camel-case=true)
        - 逻辑删除过滤由 MyBatis-Plus @TableLogic 自动注入, 不在此手写 AND deleted=0
    -->
    <select id="selectByUsername" resultType="com.xuyuan.blog.model.entity.User">
        SELECT
            id,
            username,
            password,
            nickname,
            avatar,
            email,
            status,
            last_login_at,
            create_time,
            update_time,
            create_by,
            update_by,
            deleted
        FROM t_user
        WHERE username = #{username}
        LIMIT 1
    </select>

</mapper>
