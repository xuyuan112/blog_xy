# Admin service configuration. File uploads require BLOG_MINIO_ENABLED=true and valid credentials.
BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/blog?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2b8
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=
BLOG_REDIS_HOST=127.0.0.1
BLOG_REDIS_PORT=6379
BLOG_REDIS_PASSWORD=
BLOG_JWT_SECRET=replace-with-a-random-32-byte-secret
BLOG_MINIO_ENABLED=true
BLOG_MINIO_ENDPOINT=http://127.0.0.1:9000
BLOG_MINIO_ACCESS_KEY=
BLOG_MINIO_SECRET_KEY=
BLOG_MINIO_BUCKET=blog
